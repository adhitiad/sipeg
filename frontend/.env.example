# Basis URL API backend SIMPEG. Wajib memakai prefix versi /api/v1.
#
# Pengembangan harian: pakai path same-origin `/api/v1` dan isi
# VITE_API_PROXY_TARGET di lingkungan proses dev. Server Vite akan meneruskan
# /api/v1/* ke backend, sehingga browser tidak membutuhkan CORS.
#   VITE_API_BASE_URL=/api/v1
#   VITE_API_PROXY_TARGET=http://localhost:8080
#
# Lingkungan lain: pakai URL absolut, misalnya http://localhost:8080/api/v1,
# dan pastikan origin frontend terdaftar pada TRUSTED_ORIGINS backend.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Target proksi untuk server dev (hanya dipakai saat VITE_API_PROXY_TARGET
# diisi). Bukan alamat yang dibaca antarmuka; lihat server.proxy di vite.config.ts.
VITE_API_PROXY_TARGET=

# Basis URL runtime autentikasi Better Auth.
# Kosong = same-origin /api/auth (runtime tertanam di server frontend), inilah bawaan.
# Isi hanya bila runtime autentikasi dipasang pada origin terpisah.
VITE_AUTH_BASE_URL=

# Basis URL situs web untuk tag meta berbagi (Open Graph, Twitter).
# Contoh: https://simpeg.unisubang.ac.id. Kosong = bawaan https://simpeg.unisubang.ac.id.
VITE_APP_URL=

# Variabel server-only (dibaca runtime, tidak diekspos ke browser):
#   DATABASE_URL          — koneksi Postgres untuk runtime Better Auth
#   BETTER_AUTH_SECRET    — secret sesi (>= 32 karakter)
#   TRUSTED_ORIGINS       — daftar origin yang boleh memanggil runtime (opsional)
#   BETTER_AUTH_URL       — base URL eksplisit, contoh http://localhost:3000 (opsional)
#   GOOGLE_CLIENT_ID      — client ID Google OAuth (opsional; kosong = tombol Google nonaktif)
#   GOOGLE_CLIENT_SECRET  — client secret Google OAuth (opsional; kosong = tombol Google nonaktif)
#
# Catatan: Bun memuat .env dari direktori kerja proses dev, yaitu frontend/,
# bukan akar repo. Salin nilai server-only dari .env akar repo ke frontend/.env
# (frontend/.env sudah di-gitignore) bila ingin menjalankan runtime auth.

# Variabel khusus Playwright E2E: endpoint API yang dipakai server E2E
# sengaja tetap dummy; seluruh panggilan jaringan disimulasikan di pengujian.
