# Observability stack environment (lokal, jangan commit sebagai .env)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
BLACKBOX_PORT=9115
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Alertmanager recipients (biaya $0; isi dengan saluran nyata adhitiad/admin)
ALERTMANAGER_WEBHOOK_URL=http://host.docker.internal:9999/alerts
ALERTMANAGER_CRITICAL_WEBHOOK_URL=http://host.docker.internal:9999/alerts-critical
ALERTMANAGER_EMAIL_TO=
ALERTMANAGER_EMAIL_FROM=
ALERTMANAGER_SMTP_SMARTHOST=
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=

# Database (untuk metricsexport)
DATABASE_URL=