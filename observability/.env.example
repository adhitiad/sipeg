# Salin ke .env (jangan commit nilai nyata). Semua komponen open-source, target biaya $0.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Opsional: jika menambah scraping endpoint admin via proxy aman, kelola token di secret manager/env host,
# bukan di repo dan bukan di file ini yang ter-commit.
# SIMPEG_ADMIN_SCRAPE_TOKEN=