# Core app
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/simpeg

# Shared secret Better Auth. Wajib >= 32 karakter pada production dan tidak
# boleh memakai nilai bawaan. Jangan pernah menaruhnya di repo.
BETTER_AUTH_SECRET=

# Origin browser yang diizinkan memanggil API (pisahkan dengan koma).
# Kosong berarti tidak ada akses lintas origin. Wajib pada production.
TRUSTED_ORIGINS=

# Database pool dan batas waktu statement
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_STATEMENT_TIMEOUT=15s

# Batas laju permintaan per klien (in-memory per instance)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m

# Retensi jejak audit (hari). 0 = tanpa pemotongan otomatis.
AUDIT_RETENTION_DAYS=90

# Masa berlaku sesi yang diterbitkan backend (opaque session).
# Final 23 jam sesuai keputusan pemilik.
SESSION_LIFETIME=23h

# Target pemulihan dan ketersediaan layanan
RPO_HOURS=24
RTO_HOURS=4
SLO_TARGET=99.9

# Pemeriksaan target layanan terjadwal (SLO).
#
# SLO_ENABLED mengaktifkan pengoleki metrik dan mendaftarkan pemeriksaan
# berkala "slo.evaluate" lewat QStash. Saat dimatikan, backend tidak menulis
# metrik apa pun dan tidak menambah beban pada jalur permintaan.
#
# Metrik disimpan di tabel sloMetric pada PostgreSQL, bukan di Redis.
# Alert dikirim sebagai email lewat antrean keluar persisten, sehingga
# percobaan ulang callback QStash tidak menghasilkan email ganda.
#
# SLO_P95_TARGET_MS sengaja sama dengan batas bucket histogram metrik,
# sehingga keputusan pelanggaran pada target tersebut tidak pernah meleset
# ke bawah.
SLO_ENABLED=false
SLO_WINDOW_MINUTES=5
SLO_P95_TARGET_MS=800
SLO_ERROR_RATE_TARGET=0.01
SLO_MIN_REQUESTS=20
SLO_ALERT_RECIPIENTS=
SLO_RETENTION_DAYS=30

# Zona waktu dan mata uang sistem ditetapkan di kode: penyimpanan timestamp
# memakai UTC, tampilan memakai Asia/Jakarta (UTC+7), mata uang Rupiah (IDR).

# Origin aplikasi untuk tautan pada pemberitahuan email
APP_BASE_URL=https://simpeg.unisubang.ac.id

# Email (SMTP). SMTP_FROM wajib diisi bila SMTP_HOST diisi dan harus berupa
# alamat email yang sah. Bentuk "Nama Tampilan <alamat@domain>" juga sah.
# Notifikasi gaji hanya boleh dikirim setelah pembayaran terkonfirmasi dan
# tidak pernah memuat nominal gaji.
#
# SMTP_SECURE menentukan mode keamanan: true = TLS langsung (porta 465),
# false = koneksi polos yang dinaikkan lewat STARTTLS (porta 587). Bila
# dikosongkan, mode ditebak dari porta: 465 memakai TLS langsung, porta lain
# memakai STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=no-reply@simpeg.unisubang.ac.id

# QStash untuk pekerjaan asinkron. Callback diverifikasi terhadap raw body.
# QSTASH_CURRENT_SIGNING_KEY wajib diisi bila QSTASH_TOKEN diisi.
#
# QSTASH_URL boleh diisi root API regional (mis. https://qstash-us-east-1.upstash.io)
# atau endpoint lengkap. Jalur /v2/publish ditambahkan otomatis bila belum ada.
# QSTASH_SCHEDULES_URL boleh dikosongkan: endpoint jadwal diturunkan dari
# QSTASH_URL sehingga token, publikasi, dan jadwal berada pada satu region.
QSTASH_URL=
QSTASH_SCHEDULES_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# RabbitMQ sebagai pengganti QStash pada deployment self-hosted
# (docker/podman). Bila RABBITMQ_URL diisi, backend menjalankan konsumen
# pekerjaan dari broker dan melewati pendaftaran jadwal QStash.
#
# RABBITMQ_URL hanya dibaca backend; penjadwal (cmd/jobsched) membaca
# variabel yang sama. Untuk pengembangan native, isi RABBITMQ_URL dengan
# amqp://simpeg:simpeg@localhost:5672/ dan jalankan broker dari folder
# rabbitmq/ (docker compose up -d). Pada stack container (docker-compose.yml
# root), nilai di sini ditimpa alamat broker pada jaringan bersama sehingga
# tidak berpengaruh.
#
# SLO_EVALUATE_ENABLED pada penjadwal harus sama dengan SLO_ENABLED backend:
# pemeriksaan SLO hanya diterbitkan bila pengoleki metriknya aktif.
RABBITMQ_URL=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Hari libur nasional dari api.co.id. API key dikirim pada header x-api-co-id.
# Kosong berarti layanan kalender hari libur tidak aktif dan penyegaran
# kalender dari penyedia dinonaktifkan.
HOLIDAY_API_URL=https://use.api.co.id/holidays/indonesia
HOLIDAY_API_KEY=

# Cache Redis Upstash untuk data referensi non-sensitif saja.
# Cache tidak boleh menjadi sumber kebenaran; sesi, penggajian, dan status
# pembayaran otomatis ditolak oleh lapisan cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OAuth Google untuk runtime Better Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain email yang diizinkan untuk akses SIMPEG (pisahkan dengan koma).
# Kosong berarti tidak ada pembatasan domain.
ALLOWED_EMAIL_DOMAINS=

# Mode undangan: true = akses hanya diizinkan bagi pengguna yang diundang,
# selain domain allowlist. Default false (opsional).
INVITE_ONLY=false

# Penyimpanan objek S3-compatible. Belum masuk scope MVP.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Cloudinary untuk penyimpanan berkas dokumen pegawai (KTP, KK, ijazah, SK, dst.).
# Berkas diunggah langsung ke Cloudinary oleh klien frontend; backend hanya
# menyimpan URL dan metadata berkas (ukuran, tipe MIME, public ID) pada tabel
# arsipDokumenPegawai. Diisi tiga variabel berikut agar Cloudinary.Enabled() benar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
